# === API de Anthropic (obligatorio) =====================================
ANTHROPIC_API_KEY=sk-ant-...
MODEL_RANKER=claude-haiku-4-5-20251001
MODEL_WRITER=claude-sonnet-5

# === Marca del canal ====================================================
BRAND_NAME=TU MARCA
BRAND_HANDLE=@tumarca

# === Locucion ===========================================================
# edge = gratis (Microsoft) | elevenlabs = voz de marca, de pago
TTS_PROVIDER=edge
EDGE_VOICE=es-ES-AlvaroNeural
EDGE_RATE=+12%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === YouTube (opcional) =================================================
PUBLISH_YOUTUBE=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public. Dejalo en private hasta pasar la verificacion.
YOUTUBE_PRIVACY=private

# === Instagram (opcional) ===============================================
PUBLISH_INSTAGRAM=false
IG_USER_ID=
IG_ACCESS_TOKEN=

# Alojamiento publico del MP4 (Instagram lo descarga por URL).
# Si lo dejas vacio se usan las Releases del repo indicado en GITHUB_REPO.
MEDIA_PUBLIC_BASE_URL=
GITHUB_REPO=nandito2084/tech-shorts-bot
GITHUB_TOKEN=

# === Ajustes del pipeline ===============================================
DEFAULT_LIMIT=3
HOURS_LOOKBACK=48
DEDUP_THRESHOLD=85
